{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/blind/tools/hooks/spatial-rule-hook.mjs",
            "timeout": 90,
            "statusMessage": "Checking spatial safety rule"
          }
        ]
      }
    ]
  }
}
