+        XCTAssertTrue(owner.importSelectedPhotos([.init(probe: PhotoImportProbe(), marker: 2)], enrollmentToken: nextToken))
+        await fulfillment(of: [owner.finished], timeout: 2)
+        XCTAssertEqual(owner.draftExamples, [2])
+    }
+    func testTwoPhotosAreConsumedSeriallyWithoutLoadingSecondDuringFirstInference() async throws {
+        let owner = PhotoImportHarness(), first = PhotoImportProbe(inference: true), second = PhotoImportProbe()
+        let token = try XCTUnwrap(owner.draft?.token)
+        XCTAssertTrue(owner.importSelectedPhotos([.init(probe: first, marker: 1), .init(probe: second, marker: 2)], enrollmentToken: token))
+        await fulfillment(of: [await first.inferenceEntered], timeout: 2)
+        let before = await second.transfers; XCTAssertEqual(before, 0)
+        await first.releaseInference(); await fulfillment(of: [owner.finished], timeout: 2)
+        let after = await second.transfers; XCTAssertEqual(after, 1)
+        XCTAssertEqual(owner.draftExamples, [1, 2])
+    }
+    func testRevokedConsentOrDraftDuringTransferPreventsEnqueueingInference() async throws {
+        for revokeEnabled in [true, false] {
+            let owner = PhotoImportHarness(), probe = PhotoImportProbe(transfer: true)
+            let token = try XCTUnwrap(owner.draft?.token)
+            XCTAssertTrue(owner.importSelectedPhotos([.init(probe: probe)], enrollmentToken: token))
+            await fulfillment(of: [await probe.transferEntered], timeout: 2)
+            if revokeEnabled { owner.enabled = false } else { owner.draft = .init() }
+            await probe.releaseTransfer(); await fulfillment(of: [owner.finished], timeout: 2)
+            let native = await probe.inferences; XCTAssertEqual(native, 0)
+            XCTAssertTrue(owner.draftExamples.isEmpty)
+        }
+    }
+    func testCancelBeforeTaskRunsNeverAllocatesTransfer() async throws {
+        let owner = PhotoImportHarness(), probe = PhotoImportProbe()
+        let token = try XCTUnwrap(owner.draft?.token)
+        XCTAssertTrue(owner.importSelectedPhotos([.init(probe: probe)], enrollmentToken: token))
+        owner.cancelSelectedPhotoImport()
+        await fulfillment(of: [owner.finished], timeout: 2)
+        let transfers = await probe.transfers; XCTAssertEqual(transfers, 0)
+    }
+    func testInvalidCountConsentOrDraftCannotClaimTheLane() throws {
+        let owner = PhotoImportHarness(), item = PhotosPickerItem(probe: PhotoImportProbe())
+        let token = try XCTUnwrap(owner.draft?.token)
+        XCTAssertFalse(owner.importSelectedPhotos([], enrollmentToken: token))
+        XCTAssertFalse(owner.importSelectedPhotos(Array(repeating: item, count: 7), enrollmentToken: token))
+        XCTAssertFalse(owner.importSelectedPhotos([item], enrollmentToken: UUID()))
+        owner.enabled = false
+        XCTAssertFalse(owner.importSelectedPhotos([item], enrollmentToken: token))
+        owner.enabled = true; owner.draftExamples = [1, 2, 3, 4, 5]
+        XCTAssertFalse(owner.importSelectedPhotos([item, item], enrollmentToken: token))
+        XCTAssertNil(owner.photoImportLease); XCTAssertFalse(owner.photoImportInFlight)
+    }
+    func testOversizedSyntheticCountIsRejectedBeforeInferenceWithoutAllocatingPixels() async throws {
+        let owner = PhotoImportHarness(), probe = PhotoImportProbe()
+        let token = try XCTUnwrap(owner.draft?.token)
+        XCTAssertTrue(owner.importSelectedPhotos([.init(probe: probe, count: 20_000_001)], enrollmentToken: token))
+        await fulfillment(of: [owner.finished], timeout: 2)
+        let native = await probe.inferences; XCTAssertEqual(native, 0)
+        XCTAssertTrue(owner.draftExamples.isEmpty)
+    }
