+
+private actor PhotoImportProbe {
+    let transferEntered = XCTestExpectation(description: "synthetic transfer entered")
+    let inferenceEntered = XCTestExpectation(description: "synthetic native read entered")
+    var transfers = 0, inferences = 0
+    let holdTransfer: Bool, holdInference: Bool
+    var transferWait: CheckedContinuation<Void, Never>?
+    var inferenceWait: CheckedContinuation<Void, Never>?
+    init(transfer: Bool = false, inference: Bool = false) { holdTransfer = transfer; holdInference = inference }
+    func transfer() async {
+        transfers += 1; transferEntered.fulfill()
+        if holdTransfer { await withCheckedContinuation { transferWait = $0 } }
+    }
+    func inspect() async {
+        inferences += 1; inferenceEntered.fulfill()
+        if holdInference { await withCheckedContinuation { inferenceWait = $0 } }
+    }
+    func releaseTransfer() { transferWait?.resume(); transferWait = nil }
+    func releaseInference() { inferenceWait?.resume(); inferenceWait = nil }
+}
+private struct FixtureBytes: Sendable { let count: Int; let marker: Int; let probe: PhotoImportProbe }
+private struct SelectedPhotoTransfer: Sendable { let data: FixtureBytes }
+private struct PhotosPickerItem: Sendable {
+    let probe: PhotoImportProbe
+    var count = 10, marker = 1
+    func loadTransferable(type: SelectedPhotoTransfer.Type) async throws -> SelectedPhotoTransfer? {
+        await probe.transfer()
+        return SelectedPhotoTransfer(data: .init(count: count, marker: marker, probe: probe))
+    }
+}
+private struct FamiliarAnalysis: Sendable { let marker: Int }
+private actor FamiliarInference {
+    func inspectPhoto(_ data: FixtureBytes, dualPipeline: Bool) async throws -> FamiliarAnalysis {
+        await data.probe.inspect(); return FamiliarAnalysis(marker: data.marker)
