+        !std::isfinite(c->cell_height) || c->cell_height < .01f || c->cell_height > .2f ||
+        !std::isfinite(c->max_climb) || c->max_climb < 0.f || c->max_climb > .09f ||
+        !std::isfinite(c->max_slope) || c->max_slope < 0.f || c->max_slope > 15.f ||
