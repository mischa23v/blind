+        case .wallTerminalOverlap:
+            passed = result.terminal.obstacleSurfaceIDs == [controlWall] && result.initial == empty &&
+                all.obstacleSurfaceIDs == [controlWall] && all.floorSurfaceIDs.isEmpty && all.furnitureBoundIDs.isEmpty
+        case .containedSolid:
