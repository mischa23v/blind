+        m.running = true; m.session.currentFrame?.capturedImage.renderable = false
+        m.captureExploreSnapshot()
+        XCTAssertNil(m.selectedPhotoNativeLease); XCTAssertNil(m.exploreTask)
+        XCTAssertEqual(probe.calls, 0)
+    }
