+            await fulfillment(of: [probe.entered], timeout: 2)
+            if background { m.assistantSession.foregroundActive = false }
+            else { m.assistantSession.generation += 1 }
+            probe.finish(); await task.value
+            XCTAssertNil(m.exploreSnapshot); XCTAssertNil(m.selectedPhotoNativeLease)
+        }
