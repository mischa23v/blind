+        for t in [1.1,1.2,1.3] {value.observe(session:session,tracking:.normal,mappingAvailable:true,originMatches:true,capturedAt:t,now:t)}
+        XCTAssertNil(value.association(session:session,capturedAt:1.3,now:1.3))
