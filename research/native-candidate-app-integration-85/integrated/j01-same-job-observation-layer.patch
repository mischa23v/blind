+  info=os.fstat(fd);require(stat.S_ISREG(info.st_mode) and info.st_size<=cap,'regular bounded descriptor required')
+  chunks=[];size=0
+  while True:
+   within_budget()
+   b=os.read(fd,min(1024*1024,cap+1-size))
+   if not b:break
