+ value=re.sub(r'\[[^\]\n]*\]','[values omitted]',raw)
+ value=re.sub(r'(?:/[A-Za-z0-9_.-]+){2,}', '[path omitted]',value)
+ value=''.join(c if 32<=ord(c)<=126 else ' ' for c in value)
+ return {'message':value[:768],'truncated':len(value)>768}
+
