      "seed": 271828,
      "pairs": 20,
      "repeats": 5,
      "method": "Select starts deterministically from baseline split-0.7 cells that fit the unchanged body+margin, before reading corrected classification. Pair with sufficiently separated baseline-fit goals around the fixed geometric centre where possible. Do not select from reference geometry or camera trajectory.",
